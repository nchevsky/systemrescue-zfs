#!/usr/bin/env python3
#
# SPDX-License-Identifier: GPL-3.0
#
# This script runs automatically from /etc/xdg/configure-display.desktop when Xorg starts
# It applies a scaling factor to the parimary display depending on the System-Rescue configuration file
# and size and resolution of the primary screen so things on the screen are not tiny on HiDPI screens
#
# The behavior of this script is controlled from the System-Rescue yaml configuration file
# using the "display_scale" option in the "sysconfig" category.
# Example of supported values:
# - "disabled" => Do not change the scaling factor (this is the default behavior)
# - "auto" => Automatically determine and apply the scaling factor based on screen size and resolution
# - "2.5" => Apply the scaling factor specified in the config if this is a valid number between 1.0 and 5.0
#

import json
import logging
import math
import os
import re
import subprocess
import sys

logger = None


class Display:
    def __init__(self, name, width_px, height_px, width_mm, height_mm):
        self.name = name
        self.width_px = width_px
        self.height_px = height_px
        self.width_mm = width_mm
        self.height_mm = height_mm


def initialise_logging():
    global logger
    logger = logging.getLogger()
    logger.setLevel(logging.INFO)

    formatter = logging.Formatter(
        "%(asctime)s [%(levelname)s] %(message)s", datefmt="%Y-%m-%d %H:%M:%S"
    )

    # Avoid duplicate handlers if script is re-run in same process
    if logger.handlers:
        return logger

    # stdout handler
    stdout_handler = logging.StreamHandler(sys.stdout)
    stdout_handler.setFormatter(formatter)

    # file handler (overwrite on each run)
    file_handler = logging.FileHandler("/var/log/configure-display.log", mode="w")
    file_handler.setFormatter(formatter)

    logger.addHandler(stdout_handler)
    logger.addHandler(file_handler)


def get_displays_details():
    """
    Use the randr query command to get information about all the displays
    """
    try:
        result = subprocess.run(
            ["xrandr", "--query"], capture_output=True, text=True, check=True
        )
        logger.info("Successfully executed xrandr query command")
        return result.stdout
    except Exception as e:
        logger.error(f"Failed to execute xrandr: {e}")
        return None


def determine_primary_display(output):
    """
    Returns information about the primary display
    """
    connected_displays = []

    for line in output.splitlines():
        if " connected" in line:
            connected_displays.append(line)

    # Return the only connected display if there is only one entry found
    if len(connected_displays) == 1:
        logger.info(f"Found only one connected display: {connected_displays[0]}")
        return connected_displays[0]

    # Try to find a line explicitly indicated as being the 'primary' display
    for line in connected_displays:
        if " primary " in line:
            logger.info(f"Found a display marked as the primary display: {line}")
            return line

    # Assume "eDP1" is the primary display if present (eDP1 == embedded display port)
    for line in connected_displays:
        if line.startswith("eDP1 "):
            logger.info(f"Assuming eDP1 as the primary display: {line}")
            return line

    logger.warning("Multiple connected displays found with no primary, cannot choose")
    return None


def parse_xrandr_line(line):
    """
    Parses a single xrandr line like:
    eDP-1 connected 3840x2160+0+0 (normal left inverted right x axis y axis) 344mm x 193mm
    Returns a display which contains the attributes (name, width_px, height_px, width_mm, height_mm) or None
    """
    name_match = re.match(r"^(\S+)", line)
    px_match = re.search(r"(\d+)x(\d+)\+", line)
    mm_match = re.search(r"(\d+)mm x (\d+)mm", line)

    if not (name_match and px_match and mm_match):
        logger.error("Failed to parse resolution or physical size")
        return None

    name = name_match.group(1)
    width_px, height_px = map(int, px_match.groups())
    width_mm, height_mm = map(int, mm_match.groups())

    if width_mm <= 0 or height_mm <= 0:
        logger.error("Physical size is zero or invalid")
        return None

    return Display(
        name=name,
        width_px=width_px,
        height_px=height_px,
        width_mm=width_mm,
        height_mm=height_mm,
    )


def calculate_dpi(display):
    """
    Calculate the DPI based on the screen size and resolution
    """
    try:
        width_in = display.width_mm / 25.4
        height_in = display.height_mm / 25.4
        diagonal_px = math.hypot(display.width_px, display.height_px)
        diagonal_in = math.hypot(width_in, height_in)
        dpi = diagonal_px / diagonal_in
        logger.info(f"Calculated DPI (dots per inch): {dpi:.1f}")
        return dpi
    except Exception as e:
        logger.error(f"Failed to calculate DPI: {e}")
        return None


def determine_automatic_scaling_factor(dpi):
    """
    Automatically determine what the display scaling factor should be based
    on the size and resolution of the primary screen
    """
    hidpi_dpi_threshold = 180
    standard_dpi = 96
    max_scale = 5.0
    if dpi < hidpi_dpi_threshold:
        logger.info(
            f"DPI {dpi:.1f} is below the HiDPI threshold ({hidpi_dpi_threshold}); no scaling applied"
        )
        return None

    scale = dpi / standard_dpi
    scale = min(scale, max_scale)

    # Snap to sensible steps (1.5x, 2.0x)
    scale = round(scale * 2) / 2

    if scale <= 1.0:
        logger.info("Computed scale ≤ 1.0; no scaling applied")
        return None

    logger.info(f"Determined scaling factor: {scale}x")
    return scale


def determine_desired_scaling_factor(config, dpi):
    """
    Determine what the display scaling factor should be based on the yaml configuration
    and current size and resolution of the primary screen
    """
    cfgscale = read_cfg_value(config, "sysconfig", "display_scale", "disabled", False)
    logger.info(f"The display_scale setting in the yaml config is '{cfgscale}'")

    if cfgscale == "disabled":
        logger.info("The display scaling is disabled in the yaml configuration file")
        return None

    numtest, numval = parse_number(cfgscale)
    if numtest:  # cfgscale contains a correctly formatted integer or float number
        scalefact = numval
        if 1.0 <= scalefact <= 5.0:
            logger.info(
                f"Valid display scaling number requested in the yaml configuration file: '{scalefact}'"
            )
            return scalefact
        else:
            logger.error(
                f"Invalid display scaling number requested in the yaml configuration file: '{scalefact}', it must be a number between 1.0 and 5.0"
            )
            return None

    if cfgscale == "auto":  # automatically detect the scaling factor
        scalefact = determine_automatic_scaling_factor(dpi)
        if scalefact is None:
            logger.info("No scaling change is required")
            return None
        else:
            return scalefact

    logger.error(
        f"Invalid display scaling requested in the yaml configuration file: '{cfgscale}'"
    )
    return None


def apply_scaling(dispname, scale):
    """
    Use the randr command to apply the specified scaling factor on the specified display
    """
    inv = 1.0 / scale
    cmd = ["xrandr", "--output", dispname, "--scale", f"{inv}x{inv}"]

    logger.info(f"Applying scaling factor: {scale}")
    logger.info(f"Executing xrandr command: {' '.join(cmd)}")
    result = subprocess.run(cmd, check=True)
    if result.returncode == 0:
        logger.info(
            f"Display scaling {scale} applied successfully on display {dispname}"
        )
        return True
    else:
        logger.error(f"Failed to apply scaling factor {scale} on display {dispname}")
        return False


def read_effective_config():
    """
    Read the effective configuration from the System-Rescue config file
    """
    effectivecfg = "/run/archiso/config/sysrescue-effective-config.json"
    if os.path.exists(effectivecfg) == False:
        logger.error(f"Failed to find effective configuration file in {effectivecfg}")
        return None
    with open(effectivecfg) as file:
        config = json.load(file)
        return config


def parse_number(value):
    """
    Check if a value contains a valid number and return the value of this number
    """
    try:
        return True, float(value)
    except (ValueError, TypeError):
        return False, 0.0


def strtobool(val):
    """Convert a string representation of truth to true (1) or false (0).

    True values are 'y', 'yes', 't', 'true', 'on', '1', '1.0'; false values
    are 'n', 'no', 'f', 'false', 'off', '0', '0.0'.  Raises ValueError if
    'val' is anything else.

    Function adapted from Pythons distutils.util.py because it will be deprecated soon
    Copyright (c) Python Software Foundation; All Rights Reserved
    """
    val = str(val).lower()
    if val in ("y", "yes", "t", "true", "on", "1", "1.0"):
        return True
    elif val in ("n", "no", "f", "false", "off", "0", "0.0"):
        return False
    else:
        raise ValueError("invalid truth value %r" % (val,))


def read_cfg_value(config, scope, name, defaultval, printval):
    """
    Read the value of a specific entry in the effective System-Rescue configuration
    """
    if not scope in config:
        val = defaultval
    elif name in config[scope]:
        chkval = config[scope][name]
        try:
            if isinstance(chkval, list) or isinstance(chkval, dict):
                raise TypeError(f"must be a {type(defaultval)}, not a {type(chkval)}")
            elif isinstance(defaultval, bool) and not isinstance(chkval, bool):
                val = strtobool(chkval)
            else:
                val = type(defaultval)(chkval)
        except (TypeError, ValueError) as e:
            if printval:
                logger.info(
                    f"config['{scope}']['{name}'] with {chkval} is not the same type as defaultval: {e}"
                )
            else:
                logger.info(
                    f"config['{scope}']['{name}'] is not the same type as defaultval: {e}"
                )
            val = defaultval
    else:
        val = defaultval

    if printval:
        print(f"config['{scope}']['{name}']={val}")

    return val


def main():

    initialise_logging()
    logger.info("=== configure-display script has started ===")
    xrandrout = get_displays_details()
    if not xrandrout:
        logger.error("Aborting: no xrandr output")
        return 1

    displaytxt = determine_primary_display(xrandrout)
    if not displaytxt:
        logger.error("Aborting: unable to determine primary display")
        return 2

    display = parse_xrandr_line(displaytxt)
    if not display:
        logger.error("Aborting: unable to parse display info")
        return 3
    else:
        logger.info(
            f"Primary display {display.name}: {display.width_px}x{display.height_px}px, {display.width_mm}x{display.height_mm}mm"
        )

    dpi = calculate_dpi(display)
    if dpi is None:
        logger.info("Aborting: DPI calculation failed")
        return 4

    config = read_effective_config()
    if config is None:
        logger.info("Aborting: Failed to read effective configuration file")
        return 5

    scalefact = determine_desired_scaling_factor(config, dpi)
    if scalefact is None:
        logger.info(f"Not changing the display scaling factor")
        return 6

    result = apply_scaling(display.name, scalefact)
    if result == False:
        logger.error(f"Failed to apply scaling: {e}")
        return 7

    logger.info("=== configure-display script completed successfully ===")
    return 0


if __name__ == "__main__":
    exitst = main()
    sys.exit(exitst)
